rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verificación base: usuario autenticado y con correo verificado
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Super Administradores
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "admin@reydigital.com" ||
        request.auth.token.email == "mecinfotec@gmail.com" ||
        request.auth.token.email == "admin@abnch.com"
      );
    }

    // Editores Deportivos (Solo partidos y jugadores)
    function isEditor() {
      return isAuthenticated() && (
        request.auth.token.email == "editor@funebrero.com" ||
        request.auth.token.email == "prensa@funebrero.com"
      );
    }

    // Editor Exclusivo de Socios
    function isSocioEditor() {
      return isAuthenticated() && request.auth.token.email == "socios@funebrero.com";
    }

    // Validación estricta para nuevos registros de pagos desde el Portal
    function isValidPaymentCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(["socioDni", "socioNombre", "monto", "createdAt", "status"])
        && data.socioDni is string && data.socioDni.size() >= 6 && data.socioDni.size() <= 12
        && data.socioNombre is string && data.socioNombre.size() >= 2 && data.socioNombre.size() <= 120
        && data.monto is number && data.monto >= 5000 && data.monto <= 5000000
        && data.status in ["pendiente", "acreditado_portal"];
    }

    // Colecciones públicas de solo lectura para la web
    match /fixtures/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isEditor();
    }

    match /players/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isEditor();
    }

    match /meetings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /sponsors/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /carousel_images/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /upcoming_matches/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Socios: lectura pública para la planilla, escritura solo Admin/Editor Socios
    match /socios/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSocioEditor();
    }

    // Pagos: SOLO creación validada desde el portal; lectura, edición y borrado SOLO Admin/Editor Socios
    match /pagos_socios/{docId} {
      allow read, update, delete: if isSuperAdmin() || isSocioEditor();
      allow create: if isSuperAdmin() || isSocioEditor() || isValidPaymentCreate();
    }

    // Bloqueo por defecto (Zero Trust) para cualquier otra colección
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
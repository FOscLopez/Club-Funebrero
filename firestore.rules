rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGLA ÚNICA Y LIMPIA PARA EL CLUB FUNEBRERO
    match /{document=**} {
      // Lectura pública para que la web funcione
      allow read: if true;
      
      // Escritura blindada exclusivamente para el nuevo administrador
      allow write: if request.auth != null && request.auth.token.email == "admin@reydigital.com";
    }
  }
}